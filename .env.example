# Copy to .env and edit. NEVER commit .env. Values below are placeholders only.

# Django (services/api)
SECRET_KEY=replace-with-a-long-random-unique-value
DEBUG=false                      # set true for local development only
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# PostgreSQL (used by the API and by docker-compose.yml)
DB_NAME=asg_erp
DB_USER=asg
DB_PASSWORD=replace-with-a-local-password
DB_HOST=localhost
DB_PORT=5432

# Transport hardening: off by default; enable per the future deployment ADR
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
